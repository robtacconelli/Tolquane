  "path": "showcase.py",
  "source": "\"\"\"Every block kind on one canvas: a comb, an all-to-all between two farms and a\nfeedback loop, so the editor has something with structure to draw.\"\"\"\n\nimport tolquane as tq\n\nSCALE = 3\n\n\n@tq.source\ndef rows():\n    # Ten rows of work.\n    yield from range(10)\n\n\n@tq.node\ndef parse(row: int) -> int:\n    # Cheap, so it is fused with the next stage by tq.comb.\n    return row + 1\n\n\n@tq.node\ndef scale(row: int) -> int:\n    return row * SCALE\n\n\n@tq.node\ndef shard(row: int) -> int:\n    # The left side of the all-to-all: it partitions.\n    return row\n\n\n@tq.node\ndef reduce_side(row: int) -> int:\n    # The right side of the all-to-all: it reduces.\n    return row\n\n\n@tq.node\ndef refine(row: int) -> int:\n    return row - 1\n\n\n@tq.node\ndef route(row: int, ctx: tq.Context) -> None:\n    # The loop's last stage: send on, or send round again.\n    if row <= 0:\n        ctx.send(row)\n    else:\n        ctx.feedback(row)\n\n\n@tq.sink\ndef show(row: int) -> None:\n    print(row)\n\n\ndef build(source=None):\n    start = tq.from_iterable(source) if source is not None else rows\n    cross = tq.all2all(\n        tq.farm(shard, workers=3),\n        tq.farm(reduce_side, workers=2, collect=\"round_robin\"),\n        merge=True,\n    )\n    loop = tq.feedback(tq.farm(refine, workers=4, collector=route), name=\"newton\")\n    return start >> tq.comb(parse, scale) >> cross >> loop >> show\n\n\ndef main() -> None:\n    print(tq.run(build()))\n\n\nif __name__ == \"__main__\":\n    main()\n",
